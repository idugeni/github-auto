# === Email Providers (Primary: LewatTok) ===
# LewatTok API (https://lewattok.web.id) — PRIMARY PROVIDER
LEWATTOK_API_KEY=

# Fallback providers (optional)
# Supabase — publishable key ONLY (no anon, no service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAILTM_API_TOKEN=

# Email provider selection: lewattok (default), supabase, gmail, mailtm
EMAIL_PROVIDER=lewattok

# === CAPTCHA Solving ===
# Groq API for Whisper ASR (reCAPTCHA audio)
GROQ_API_KEY=

# CapSolver API (hCaptcha/FunCaptcha fallback)
CAPSOLVER_API_KEY=

# === Browser ===
# Set to "true" for visible browser, "false" for headless
BROWSER_HEADLESS=false

# Browser driver: camoufox (default), patchright
BROWSER_DRIVER=camoufox

# === Proxy ===
# Single proxy: protocol://user:pass@host:port
# Or use proxies.txt for rotation
PROXY_URL=

# === Registration ===
REGISTRATION_PASSWORD=AutoGen2026!
OTP_TIMEOUT=120
BATCH_DELAY_BASE=8
BATCH_DELAY_JITTER=2
MAX_RETRIES=2

# === Logging ===
LOG_LEVEL=INFO
